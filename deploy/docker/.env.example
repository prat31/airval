# Copy to .env next to compose.yaml and edit. `docker compose up -d` reads it automatically.

# Image to run (build locally with `docker compose build`, or pull a release).
AIRVAL_IMAGE=ghcr.io/prat31/airval:latest

# REQUIRED. 32 random bytes, base64. Generate: docker run --rm ghcr.io/prat31/airval secrets gen-key
# Keep it safe and stable: it encrypts every stored secret.
AIRVAL_SECRETS_MASTER_KEY=

# REQUIRED. Postgres password (used by the bundled postgres and in the connection URL).
POSTGRES_PASSWORD=

# Public URL users open (used for links and cookies). Set AIRVAL_AUTH_COOKIE_SECURE=true behind TLS.
AIRVAL_SERVER_BASE_URL=http://localhost:8080
AIRVAL_AUTH_COOKIE_SECURE=false
AIRVAL_PORT=8080

# Optional first-boot admin (created only while there are no users).
AIRVAL_BOOTSTRAP_ADMIN_EMAIL=
AIRVAL_BOOTSTRAP_ADMIN_PASSWORD=
AIRVAL_BOOTSTRAP_ORG_NAME=Default

# Per-worker concurrency (parallel examples in flight).
AIRVAL_WORKERS_CONCURRENCY=256

AIRVAL_TELEMETRY_LOG_LEVEL=info
